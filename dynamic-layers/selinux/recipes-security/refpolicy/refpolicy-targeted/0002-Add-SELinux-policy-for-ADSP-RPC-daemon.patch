 policy/modules/services/qcom_adsprpcd.fc |  4 +++
 policy/modules/services/qcom_adsprpcd.if |  6 ++++
 policy/modules/services/qcom_adsprpcd.te | 37 ++++++++++++++++++++++++
 3 files changed, 47 insertions(+)
 create mode 100644 policy/modules/services/qcom_adsprpcd.fc
