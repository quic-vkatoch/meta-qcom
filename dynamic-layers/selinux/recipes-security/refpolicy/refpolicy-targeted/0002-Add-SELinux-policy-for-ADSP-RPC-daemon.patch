+
+/usr/bin/adsprpcd -- gen_context(system_u:object_r:qcom_adsprpcd_exec_t,s0)
diff --git a/policy/modules/services/qcom_adsprpcd.if b/policy/modules/services/qcom_adsprpcd.if
new file mode 100644
index 000000000..9b5b42ea2
--- /dev/null
+++ b/policy/modules/services/qcom_adsprpcd.if
@@ -0,0 +1,6 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+## <summary>
+## qcom_adsprpcd
+## </summary>
diff --git a/policy/modules/services/qcom_adsprpcd.te b/policy/modules/services/qcom_adsprpcd.te
new file mode 100644
index 000000000..779727173
--- /dev/null
+++ b/policy/modules/services/qcom_adsprpcd.te
@@ -0,0 +1,37 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+policy_module(qcom_adsprpcd,1.0)
+
+type qcom_adsprpcd_t;
+type qcom_adsprpcd_exec_t;
+
+init_daemon_domain(qcom_adsprpcd_t, qcom_adsprpcd_exec_t)
+
+# Unix domain socket permissions for logging
+allow qcom_adsprpcd_t self:unix_dgram_socket { create_socket_perms sendto };
+
+# Access to FastRPC ADSP devices
+qcom_adsp_secure_read_device(qcom_adsprpcd_t)
+qcom_adsp_read_device(qcom_adsprpcd_t)
+
+# Access to DMA heap device (/dev/dma_heap/system)
+dev_rw_dma_dev(qcom_adsprpcd_t)
+
+# Read device tree model information from sysfs
+dev_read_sysfs(qcom_adsprpcd_t)
+
+# Read files in /usr/share/qcom/
+files_read_usr_files(qcom_adsprpcd_t)
+
+# Watch directories for DSP library changes
+dev_watch_dev_dirs(qcom_adsprpcd_t)
+libs_watch_shared_libs_dirs(qcom_adsprpcd_t)
+files_watch_usr_dirs(qcom_adsprpcd_t)
+
+# Logging support
+init_search_runtime(qcom_adsprpcd_t)
+logging_send_syslog_msg(qcom_adsprpcd_t)
+
+# Read localization files
+miscfiles_read_localization(qcom_adsprpcd_t)
