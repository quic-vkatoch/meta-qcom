From f29985973d0255379d1ea14305e567f7ad95e53f Mon Sep 17 00:00:00 2001
From: Vinayak Katoch <vkatoch@qti.qualcomm.com>
Date: Wed, 7 Jan 2026 15:48:32 +0530
Subject: [PATCH 5/5] Add SELinux policy for SDSP RPC daemon

Define security policy for sdsprpcd daemon (/usr/bin/sdsprpcd) that
manages FastRPC communication with the SDSP subsystem.

Create new policy module qcom_sdsprpcd with daemon domain and required
permissions for SDSP device access, DMA operations, and system integration.

- qcom_sdsprpcd.fc: Label sdsprpcd executable as qcom_sdsprpcd_exec_t
- qcom_sdsprpcd.te: Define qcom_sdsprpcd_t daemon domain with permissions:
  * Unix datagram socket creation and sendto for logging
  * SDSP device access (secure /dev/fastrpc-sdsp-secure and non-secure
    /dev/fastrpc-sdsp) via qcom_sdsp_*_read_device() interfaces
  * DMA heap device access (/dev/dma_heap/system) for shared memory
  * Sysfs reading for device tree model information
  * Configuration file reading from /usr/share/qcom/
  * Directory watching (inotify) for /dev, /usr/lib, and /usr/share
  * Runtime directory search and syslog messaging
  * Localization file access
- qcom_sdsprpcd.if: Placeholder interface file for future extensions

The policy uses interface macros from devices.if for clean abstraction
and maintainability. All device access permissions (getattr, ioctl) are
provided automatically through read_chr_files_pattern() and
rw_chr_files_pattern() macros.

Signed-off-by: Vinayak Katoch <vkatoch@qti.qualcomm.com>

Upstream-Status: Inappropriate [Qualcomm specific change]
---
 policy/modules/services/qcom_sdsprpcd.fc |  4 +++
 policy/modules/services/qcom_sdsprpcd.if |  6 ++++
 policy/modules/services/qcom_sdsprpcd.te | 37 ++++++++++++++++++++++++
 3 files changed, 47 insertions(+)
 create mode 100644 policy/modules/services/qcom_sdsprpcd.fc
 create mode 100644 policy/modules/services/qcom_sdsprpcd.if
 create mode 100644 policy/modules/services/qcom_sdsprpcd.te

diff --git a/policy/modules/services/qcom_sdsprpcd.fc b/policy/modules/services/qcom_sdsprpcd.fc
new file mode 100644
index 000000000..236fa3125
--- /dev/null
+++ b/policy/modules/services/qcom_sdsprpcd.fc
@@ -0,0 +1,4 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+/usr/bin/sdsprpcd -- gen_context(system_u:object_r:qcom_sdsprpcd_exec_t,s0)
diff --git a/policy/modules/services/qcom_sdsprpcd.if b/policy/modules/services/qcom_sdsprpcd.if
new file mode 100644
index 000000000..367dc8d55
--- /dev/null
+++ b/policy/modules/services/qcom_sdsprpcd.if
@@ -0,0 +1,6 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+## <summary>
+## qcom_sdsprpcd
+## </summary>
diff --git a/policy/modules/services/qcom_sdsprpcd.te b/policy/modules/services/qcom_sdsprpcd.te
new file mode 100644
index 000000000..2bcf223f6
--- /dev/null
+++ b/policy/modules/services/qcom_sdsprpcd.te
@@ -0,0 +1,37 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+policy_module(qcom_sdsprpcd,1.0)
+
+type qcom_sdsprpcd_t;
+type qcom_sdsprpcd_exec_t;
+
+init_daemon_domain(qcom_sdsprpcd_t, qcom_sdsprpcd_exec_t)
+
+# Unix domain socket permissions for logging
+allow qcom_sdsprpcd_t self:unix_dgram_socket { create_socket_perms sendto };
+
+# Access to FastRPC SDSP devices
+qcom_sdsp_secure_read_device(qcom_sdsprpcd_t)
+qcom_sdsp_read_device(qcom_sdsprpcd_t)
+
+# Access to DMA heap device (/dev/dma_heap/system)
+dev_rw_dma_dev(qcom_sdsprpcd_t)
+
+# Read device tree model information from sysfs
+dev_read_sysfs(qcom_sdsprpcd_t)
+
+# Read files in /usr/share/qcom/
+files_read_usr_files(qcom_sdsprpcd_t)
+
+# Watch directories for DSP library changes
+dev_watch_dev_dirs(qcom_sdsprpcd_t)
+libs_watch_shared_libs_dirs(qcom_sdsprpcd_t)
+files_watch_usr_dirs(qcom_sdsprpcd_t)
+
+# Logging support
+init_search_runtime(qcom_sdsprpcd_t)
+logging_send_syslog_msg(qcom_sdsprpcd_t)
+
+# Read localization files
+miscfiles_read_localization(qcom_sdsprpcd_t)
