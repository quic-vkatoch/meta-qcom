 policy/modules/services/qcom_cdsprpcd.fc |  4 +++
 policy/modules/services/qcom_cdsprpcd.if |  6 ++++
 policy/modules/services/qcom_cdsprpcd.te | 37 ++++++++++++++++++++++++
 3 files changed, 47 insertions(+)
 create mode 100644 policy/modules/services/qcom_cdsprpcd.fc
 create mode 100644 policy/modules/services/qcom_cdsprpcd.if
 create mode 100644 policy/modules/services/qcom_cdsprpcd.te

