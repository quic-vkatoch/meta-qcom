+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+/usr/bin/cdsprpcd -- gen_context(system_u:object_r:qcom_cdsprpcd_exec_t,s0)
diff --git a/policy/modules/services/qcom_cdsprpcd.if b/policy/modules/services/qcom_cdsprpcd.if
new file mode 100644
index 000000000..eebd8fb5c
--- /dev/null
+++ b/policy/modules/services/qcom_cdsprpcd.if
@@ -0,0 +1,6 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+## <summary>
+## qcom_cdsprpcd
+## </summary>
diff --git a/policy/modules/services/qcom_cdsprpcd.te b/policy/modules/services/qcom_cdsprpcd.te
new file mode 100644
index 000000000..b1442255f
--- /dev/null
+++ b/policy/modules/services/qcom_cdsprpcd.te
@@ -0,0 +1,37 @@
+# Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+# SPDX-License-Identifier: BSD-3-Clause-Clear
+
+policy_module(qcom_cdsprpcd,1.0)
+
+type qcom_cdsprpcd_t;
+type qcom_cdsprpcd_exec_t;
+
+init_daemon_domain(qcom_cdsprpcd_t, qcom_cdsprpcd_exec_t)
+
+# Unix domain socket permissions for logging
+allow qcom_cdsprpcd_t self:unix_dgram_socket { create_socket_perms sendto };
+
+# Access to FastRPC CDSP devices
+qcom_cdsp_secure_read_device(qcom_cdsprpcd_t)
+qcom_cdsp_read_device(qcom_cdsprpcd_t)
+
+# Access to DMA heap device (/dev/dma_heap/system)
+dev_rw_dma_dev(qcom_cdsprpcd_t)
+
+# Read device tree model information from sysfs
+dev_read_sysfs(qcom_cdsprpcd_t)
+
+# Read files in /usr/share/qcom/
+files_read_usr_files(qcom_cdsprpcd_t)
+
+# Watch directories for DSP library changes
+dev_watch_dev_dirs(qcom_cdsprpcd_t)
+libs_watch_shared_libs_dirs(qcom_cdsprpcd_t)
+files_watch_usr_dirs(qcom_cdsprpcd_t)
+
+# Logging support
+init_search_runtime(qcom_cdsprpcd_t)
+logging_send_syslog_msg(qcom_cdsprpcd_t)
+
+# Read localization files
+miscfiles_read_localization(qcom_cdsprpcd_t)
